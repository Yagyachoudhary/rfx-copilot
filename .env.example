# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Anthropic (server-side only, never exposed to the browser) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional model overrides
AI_MODEL_EXTRACTION=claude-sonnet-5-5
AI_MODEL_ANALYST=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5

# --- Demo FX policy (no live FX feed in the prototype) ---
# Used only when a supplier quotes in a non-INR currency. Shown to the buyer on every converted value.
DEMO_FX_USD_INR=84.20
DEMO_FX_AS_OF=2026-10-20
